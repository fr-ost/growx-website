# Copy to .env.local and fill in. Never commit real values.

# --- Public (safe to expose to the browser) ---
# Canonical site URL, no trailing slash. Used for auth redirects, sitemap, metadata.
# Production: https://www.growxapp.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and publishable (anon) key: Project Settings > API.
# The Vercel Supabase integration names also work: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Set to "true" only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Chrome Web Store listing URL for GrowX.
# Defaults to the official listing in src/config/site.ts; set only to override.
NEXT_PUBLIC_CHROME_STORE_URL=
# Search-console verification tokens (HTML meta-tag method). See docs/SEO.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Public support email shown on /contact (defaults to support@growxapp.org).
NEXT_PUBLIC_SUPPORT_EMAIL=support@growxapp.org

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Needed by trial activation and /api/health (SQL functions restricted to service_role).
# SUPABASE_SECRET_KEY (new sb_secret_ keys) is accepted as well.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated exact origins allowed to call /api/entitlement from an extension,
# GrowX: chrome-extension://ofiancichfcakbdgekhcahflpoglfgbh . Empty = no cross-origin access.
ALLOWED_EXTENSION_ORIGINS=

# Grace period (days) after a failed recurring payment before reverting to Free (0-14).
BILLING_GRACE_DAYS_CARD=3
BILLING_GRACE_DAYS_CRYPTO=0

# (Payment settings are at the bottom of this file.)

# =============================================================================
# PAYMENTS (Phase 3). Placeholders only: configure real values in Vercel's
# environment-variable settings, never in the repository. Everything below is
# optional: checkout stays unavailable for any provider that is not fully set.
# =============================================================================
# "sandbox" (default) or "production". Production ALSO requires BILLING_LIVE_APPROVED=true.
BILLING_LIVE_APPROVED=false
# The early-adopter $0.99 offer stays off until you explicitly enable it (after sandbox verification).
EARLY_ADOPTER_ENABLED=false

# --- Paddle (cards) ----------------------------------------------------------
PADDLE_ENV=sandbox
# Server API key (Paddle > Developer tools > Authentication). Sandbox keys contain "sdbx".
PADDLE_API_KEY=
# Client-side token (safe for the browser). Sandbox tokens start with "test_".
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Notification destination "endpoint secret key" (Paddle > Developer tools > Notifications).
PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) of the prices YOU create in the Paddle dashboard.
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=
PADDLE_PRICE_ID_LIFETIME=
PADDLE_PRICE_ID_EARLY_ADOPTER=

# --- NOWPayments (crypto, prepaid periods) -----------------------------------
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_API_KEY=
# IPN secret key (NOWPayments dashboard > Store settings > IPN).
NOWPAYMENTS_IPN_SECRET=
# Assets customers may pay with (code includes network), comma separated. Verify codes in your account.
NOWPAYMENTS_PAY_CURRENCIES=usdttrc20,usdterc20,usdcerc20
