# Copy to .env.local and fill in. Never commit real values.

# --- Public (safe to expose to the browser) ---
# Canonical site URL, no trailing slash. Used for auth redirects, sitemap, metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and publishable (anon) key: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Set to "true" only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Chrome Web Store listing URL for GrowX. Leave empty until it is confirmed.
NEXT_PUBLIC_CHROME_STORE_URL=
# Public support email shown on /contact. Leave empty to hide it.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Needed only by the trial-activation action (calls a SQL function restricted to service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated exact origins allowed to call /api/entitlement from an extension,
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop . Empty = no cross-origin access.
ALLOWED_EXTENSION_ORIGINS=

# --- Reserved for future payment phases (unused today) ---
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
